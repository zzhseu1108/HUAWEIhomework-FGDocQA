# FGDocQA 模型配置
# 默认 Mock：完整链路可离线跑通，向量/精排/VL 为规则替身，聊天使用片段式回答。
# 启用 API 时，请按 README 设置模式、端点与有效令牌，再运行 ./run.sh probe。
# API 模式会向配置端点发送相应文本/图片；请使用获准的服务。

# mock | http
DOCQA_MODEL_MODE=mock
# 例如 https://model-gateway.example.com/v1
DOCQA_BASE_URL=
DOCQA_API_KEY=

# 可按能力覆盖全局模式；留空继承 DOCQA_MODEL_MODE
DOCQA_EMBED_MODE=
DOCQA_RERANK_MODE=
DOCQA_CHAT_MODE=
DOCQA_VL_MODE=

# 聊天可单独使用其他端点与 Key；分别留空时继承通用配置
DOCQA_CHAT_BASE_URL=
DOCQA_CHAT_API_KEY=

# 以下模型名为示例，HTTP 模式需与服务商实际提供的模型 ID 一致
DOCQA_CHAT_MODEL=deepseek-v4.1-flash
DOCQA_VL_MODEL=Qwen3.6-27B-VL
DOCQA_EMBED_MODEL=Qwen3-Embedding-8B
DOCQA_RERANK_MODEL=Qwen3-Reranker-8B

DOCQA_TIMEOUT=30
# Mock 模式哈希向量维度（真实模型不需要）
DOCQA_EMBED_DIM=512
